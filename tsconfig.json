{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2020",
		"lib": ["es2020"],
		"removeComments": true,
		"esModuleInterop": true,
		"declaration": true,
		"outDir": "./dist",
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["credentials/**/*", "nodes/**/*", "package.json"]
}
